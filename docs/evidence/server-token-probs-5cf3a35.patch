+def test_n_probs_token_ids():
+    global server
+    server.start()
+    data = {
+        "prompt": "I believe the meaning of life is",
+        "temperature": 0.0,
+        "n_predict": 1,
+    }
+    res = server.make_request("POST", "/completion", data={**data, "n_probs": 10})
+    assert res.status_code == 200
+    top = res.body["completion_probabilities"][0]["top_logprobs"]
+    top_ids = [p["id"] for p in top]
+    # one id from the top list, one outside it
+    other_id = next(i for i in range(100, 500) if i not in top_ids)
+    ids = [top_ids[3], other_id]
+    res = server.make_request("POST", "/completion", data={**data, "token_ids_logprob": ids})
+    assert res.status_code == 200
+    tok = res.body["completion_probabilities"][0]
+    assert tok["top_logprobs"] == []
+    probs = tok["token_ids_logprobs"]
+    assert [p["id"] for p in probs] == ids
+    assert probs[0]["logprob"] == pytest.approx(top[3]["logprob"], abs=1e-5)
+    assert probs[1]["logprob"] < top[-1]["logprob"]
+    res = server.make_request("POST", "/completion", data={**data, "token_ids_logprob": [-1]})
+    assert res.status_code == 400
+
+
 def test_n_probs_post_backend_sampling():
     """Verify that the same probabilities are returned with and without backend sampling."""
     global server
